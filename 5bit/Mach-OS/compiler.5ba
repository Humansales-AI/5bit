; compiler.5ba — 5bit→x86-64 compiler in 5basm
; Reads source tokens from SRC slots, emits x86-64 bytes to OUT slots.
; Source notation assembled by griddb_asm.py into compiler.5b tokens.
; The assembled tokens are loaded by bootstrap.c and executed.

; Scalar working slots
; SRC_N=10: source token count
; OUT_N=11: output byte count
; IP=20: instruction pointer
; OP=21: output pointer
; TK=22: current token
; TMP=23: temporary

; Initialize
int 0
raw START START START START D6 END END END END D3 END  ; STORE 20 — IP=0
int 0
raw START START START START D6 END END END END D3 END  ; STORE 21 — OP=0

; ----- Main loop -----
; LOOP (
;   READ IP · READ SRC_N · MINUS · IF (+:BREAK)(0:BREAK)(-:compile)
;   ...compile current token...
;   READ OP · STORE 11   ; OUT_N = OP
; )
; RET appended after loop

raw START START START START D5 END END END END   ; LOOP — enter loop
raw LPAREN  ; (

; -- Loop body: check IP >= N --
raw START START START START D8 END END END END D2 END   ; READ IP (slot 20)
raw START START START START D8 END END END END D1 END   ; READ SRC_N (slot 10)
raw D1 END ; 1 = token for int 1? No — MINUS is token 11
raw START START START START D4 END END END END         ; IF
raw LPAREN                                            ; +arm: IP > N
raw START START START START D6 END END END END          ; BREAK
raw RPAREN
raw LPAREN                                            ; 0arm: IP == N
raw START START START START D6 END END END END          ; BREAK
raw RPAREN
raw LPAREN                                            ; -arm: IP < N — compile
; Token 0: emit literal 0
; Bytes: 48,0,0,0,0,0,0,0,0,80
int 48
int 1000
raw START START START START D8 END END END END D3 END
raw PLUS
raw START START START START D6 END END END END D3 END D2 END D3 END
; OP++
raw START START START START D8 END END END END D3 END
int 1
raw PLUS
raw START START START START D6 END END END END D3 END
int 0
int 1000
raw START START START START D8 END END END END D3 END
raw PLUS
raw START START START START D6 END END END END D3 END D2 END D3 END
