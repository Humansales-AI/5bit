# Dockerfile for 5bit WebRTC Signaling Server
# Build: docker build -f Dockerfile.webrtc -t fivebit-webrtc .
# Deploy to Railway: railway up --service webrtc-signaling

FROM alpine:3.19

RUN apk add --no-cache gcc musl-dev openssl-dev openssl-libs-static

WORKDIR /app
COPY c/fivebit_webrtc.c .
COPY c/fivebit_grid.c .
COPY c/fivebit_grid.h .

# Compile the C server: static binary, zero runtime deps
RUN gcc -O2 -static -o fivebit_webrtc fivebit_webrtc.c fivebit_grid.c -lssl -lcrypto && \
    strip fivebit_webrtc

EXPOSE 8085

# Data directory for the 5bit grid
VOLUME /data

CMD ["./fivebit_webrtc", "8085", "/data"]
